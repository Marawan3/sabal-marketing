# Public site origin used for canonicals, sitemap, and OG URLs.
# Preview deploys stay noindex until this host is wuntab.com or www.wuntab.com
# (or you set NEXT_PUBLIC_ALLOW_INDEXING=true).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_CONTACT_EMAIL="hello@wuntab.com"

# Book-a-demo target. Default is mailto the contact address.
# Swap for a Cal link when Marawan supplies one.
# NEXT_PUBLIC_DEMO_HREF="https://cal.com/example"

# Force indexing on/off. If unset, indexing follows the SITE_URL host.
# NEXT_PUBLIC_ALLOW_INDEXING="false"

# This app must never receive DATABASE_URL, Clerk secrets, Blob write tokens,
# NMI keys, Resend keys, or any other product-repo secret.
