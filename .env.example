# Public site origin used for canonicals, sitemap, and OG URLs.
# Preview deploys stay noindex until this host is sabal.ai or www.sabal.ai
# (or you set NEXT_PUBLIC_ALLOW_INDEXING=true).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ROS sign-in. Today this is the apex app. Option A would move it to app.sabal.ai.
NEXT_PUBLIC_APP_URL="https://sabal.ai"

NEXT_PUBLIC_CONTACT_EMAIL="hello@sabal.ai"

# Demo form (the only server secret this app should ever hold).
RESEND_API_KEY=""
RESEND_FROM="Sabal <hello@sabal.ai>"
DEMO_INBOX="hello@sabal.ai"
DEMO_WEBHOOK_URL=""

# Optional. Leave empty to ship zero third-party scripts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Force indexing on/off. If unset, indexing follows the SITE_URL host.
# NEXT_PUBLIC_ALLOW_INDEXING="false"

# This app must never receive DATABASE_URL, Clerk secrets, Blob write tokens, or NMI keys.
